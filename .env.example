# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Credencial exclusiva do dashboard (somente no servidor, mínimo recomendado: 32 bytes aleatórios)
DASHBOARD_API_TOKEN=

# Ponte local do Sighra (somente servidor; mesma chave no PC, mínimo 32 caracteres)
SIGHRA_BRIDGE_TOKEN=
# Exclusivo para o servidor local isolado do notebook. Nunca habilitar em produção.
SIGHRA_LOCAL_BRIDGE_TEST=false
SIGHRA_LOCAL_BRIDGE_TOKEN=

# Jornada SIGhRa: produção permanece desabilitada sem configuração explícita.
# Desenvolvimento local usa pilot + mock por padrão.
NEXT_PUBLIC_SIGHRA_JOURNEY_MODE=disabled
NEXT_PUBLIC_SIGHRA_JOURNEY_PROVIDER=mock

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Sistema de Acionamento Logístico"
